APP_NAME=DropWatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dropwatch
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@dropwatch.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# CZDS (ICANN Central Zone Data Service)
# Credentials are read from here only. Never commit real values.
# ---------------------------------------------------------------------------
CZDS_USERNAME=
CZDS_PASSWORD=
CZDS_USER_AGENT="DropWatch/1.0 (olaogunteslim@gmail.com)"
CZDS_AUTH_URL=https://account-api.icann.org/api/authenticate
CZDS_LINKS_URL=https://czds-api.icann.org/czds/downloads/links

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DATABASE=zones
CLICKHOUSE_CLIENT_BIN=clickhouse-client

# ---------------------------------------------------------------------------
# Zone processing
# ---------------------------------------------------------------------------
ZONES_DIR=/var/lib/dropwatch/zones
SORT_TMP_DIR=/var/tmp/dropwatch-sort
ZONE_CAT_BINARY="gzip -dc"
KEEP_RAW=false
ZONE_RETAIN_DAYS=45
ZONE_SNAPSHOT_RETENTION_DAYS=45
ZONE_STALE_AFTER_HOURS=20
ZONE_STALE_RETRY_MINUTES=30
ZONE_STALE_MAX_RETRIES=4
# The download step can sleep up to 2 hours waiting for a fresh zone file, so
# the database queue must not re-deliver the job while it is still running.
DB_QUEUE_RETRY_AFTER=10800
ZONES_QUEUE=zones
ZONES_SCHEDULE="0 8 * * *"
ZONES_HEARTBEAT_STALE_SECONDS=180

# ---------------------------------------------------------------------------
# Drop prediction (a removed name is never available)
# ---------------------------------------------------------------------------
ZONE_REDEMPTION_DAYS=30
ZONE_PENDING_DELETE_DAYS=5

# ---------------------------------------------------------------------------
# Weaker version search
# ---------------------------------------------------------------------------
WEAKER_MAX_PER_RULE=50
WEAKER_PHASE2_ENABLED=false

# Rendering only: DropWatch never fetches RDAP. {domain} is URL-encoded.
LOOKUP_LINK_TEMPLATE="https://rdap.org/domain/{domain}"

# ---------------------------------------------------------------------------
# Zone access expiry (fallback until CZDS reports it)
# ---------------------------------------------------------------------------
ZONE_ACCESS_WARNING_DAYS=14
ZONE_ACCESS_EXPIRY_BIZ=2026-11-08
